# Semua variabel bersifat opsional. Nilai di bawah adalah nilai bawaan.

# Port server lokal
PORT=3000

# Lokasi berkas basis data SQLite dan folder unggahan
# DB_FILE=./data/pickabite.db
# UPLOAD_DIR=./uploads

# Mode lokal: kode OTP ditampilkan di layar dan di log server karena belum ada server email.
SHOW_OTP=true

# Aturan bisnis (lihat docs/BA_Dokumen_Analisis_Kebutuhan.md bagian aturan bisnis)
MAX_ACTIVE_ORDERS=3        # BR-06 batas pesanan aktif per akun
PAYMENT_WINDOW_MIN=15      # BR-08 batas waktu bayar QRIS (menit)
NO_SHOW_GRACE_MIN=30       # BR-09 toleransi sebelum ditandai tidak diambil (menit)
REMINDER_AFTER_MIN=10      # pengingat ambil setelah pesanan siap (menit)
VIOLATION_WINDOW_DAYS=7    # BR-10 jendela hitung pelanggaran (hari)
VIOLATIONS_TO_BLOCK=3      # BR-10 jumlah pelanggaran yang memicu blokir
BLOCK_HOURS=24             # BR-10 lama blokir sementara (jam)
